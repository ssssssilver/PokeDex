.pocket-pack-page { padding-bottom: 44rpx; }.pack-head { padding: 22rpx; border-left: 8rpx solid #0f766e; background: #182230; color: #fff; }.pack-identity { display: flex; align-items: center; gap: 18rpx; min-height: 150rpx; }.pack-cover { flex: 0 0 auto; width: 130rpx; height: 150rpx; }.pack-copy { min-width: 0; flex: 1; }.pack-series { color: #5eead4; font-size: 21rpx; font-weight: 900; }.pack-title { margin-top: 6rpx; font-size: 34rpx; font-weight: 900; }.pack-desc { margin-top: 6rpx; color: #cbd5e1; font-size: 21rpx; }.pack-stats { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 20rpx; border-top: 1rpx solid #3d4858; }.pack-stats view { padding-top: 14rpx; text-align: center; }.pack-stats strong,.pack-stats text { display: block; }.pack-stats strong { font-size: 26rpx; }.pack-stats text { margin-top: 3rpx; color: #94a3b8; font-size: 18rpx; }.pack-options { margin: 16rpx 0; white-space: nowrap; }.pack-option { display: inline-flex; align-items: center; width: 220rpx; min-height: 104rpx; margin-right: 10rpx; padding: 8rpx 12rpx; border: 1rpx solid #dce3e9; border-radius: 8rpx; background: #fff; box-sizing: border-box; vertical-align: top; }.pack-option > image { flex: 0 0 auto; width: 58rpx; height: 78rpx; margin-right: 8rpx; }.pack-option-copy { min-width: 0; flex: 1; }.pack-option text { color: #0f766e; font-size: 19rpx; font-weight: 900; }.pack-option-copy view { overflow: hidden; margin-top: 3rpx; color: #334155; font-size: 20rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.pack-option.selected { border-color: #0f766e; background: #eaf8f5; }.open-command { min-height: 72rpx; border-radius: 8rpx; background: #0f766e; color: #fff; font-size: 27rpx; font-weight: 900; line-height: 72rpx; text-align: center; }.open-command.disabled { background: #94a3b8; }.pack-state { padding: 48rpx 20rpx; border: 1rpx solid #e1e7ec; background: #fff; color: #64748b; text-align: center; }.pack-state.error { color: #b42318; }.result-head { display: flex; align-items: center; justify-content: space-between; margin: 24rpx 0 14rpx; color: #64748b; font-size: 22rpx; }.result-head text { display: block; color: #b7791f; font-size: 20rpx; font-weight: 900; }.result-head strong { display: block; margin-top: 3rpx; color: #182230; font-size: 28rpx; }.pull-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; }.pull-card { position: relative; min-width: 0; padding: 12rpx; border: 1rpx solid #e1e7ec; border-radius: 8rpx; background: #fff; }.slot-number { position: absolute; z-index: 2; top: 18rpx; left: 18rpx; display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: #182230; color: #fff; font-size: 18rpx; font-weight: 900; }.pull-art { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 5 / 7; background: #f3f6f8; border-radius: 8rpx; }.pull-art image { width: 96%; height: 96%; }.pull-name,.pull-meta { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.pull-name { margin-top: 8rpx; color: #182230; font-size: 25rpx; font-weight: 900; }.pull-meta { margin-top: 3rpx; color: #718096; font-size: 19rpx; }
