.pocket-decks-page { padding-bottom: 44rpx; }.deck-summary { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; padding: 18rpx 20rpx; border-left: 8rpx solid #0f766e; background: #182230; color: #fff; }.deck-summary text { font-size: 34rpx; font-weight: 900; }.deck-summary view view { margin-top: 2rpx; color: #cbd5e1; font-size: 21rpx; }.summary-source { color: #5eead4; font-size: 19rpx; font-weight: 900; }.ranking-list { border-top: 1rpx solid #e1e7ec; }.ranking-row { display: flex; align-items: center; min-height: 120rpx; padding: 12rpx 4rpx; border-bottom: 1rpx solid #e1e7ec; }.ranking-number { display: flex; align-items: center; justify-content: center; flex: 0 0 46rpx; height: 46rpx; border-radius: 50%; background: #182230; color: #fff; font-size: 21rpx; font-weight: 900; }.ranking-icons { display: flex; flex: 0 0 96rpx; margin-left: 12rpx; }.ranking-icons image { width: 56rpx; height: 56rpx; margin-right: -16rpx; }.ranking-copy { flex: 1; min-width: 0; margin-left: 10rpx; }.ranking-name { overflow: hidden; color: #182230; font-size: 26rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.ranking-score { margin-top: 5rpx; color: #718096; font-size: 19rpx; }.ranking-metrics { display: grid; grid-template-columns: auto auto; gap: 1rpx 7rpx; flex: 0 0 auto; text-align: right; }.ranking-metrics strong { color: #0f766e; font-size: 20rpx; }.ranking-metrics text { color: #94a3b8; font-size: 17rpx; }.deck-state { padding: 54rpx 20rpx; border: 1rpx solid #e1e7ec; background: #fff; color: #64748b; text-align: center; }.deck-state.error { color: #b42318; }
