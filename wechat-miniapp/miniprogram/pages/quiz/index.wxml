<view wx:if="{{quiz}}" class="page quiz-page">
  <view class="card quiz-card">
    <view class="muted">随机挑战</view>
    <view class="quiz-title">猜猜这是谁？</view>
    <image class="silhouette {{result ? 'revealed' : ''}}" src="{{quiz.silhouette}}" mode="aspectFit" />
  </view>

  <view class="card hint-card">
    <view class="hint-row" wx:for="{{quiz.hints}}" wx:key="*this" wx:if="{{index < revealedHints}}">
      {{item}}
    </view>
    <view wx:if="{{revealedHints < quiz.hints.length && !result}}" class="button-secondary" bindtap="revealHint">再看一个提示</view>
  </view>

  <view class="option-grid">
    <view wx:for="{{quiz.options}}" wx:key="id" class="option-card card {{selectedId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseOption">
      <view class="option-name">{{item.name_zh}}</view>
      <view class="muted">#{{item.id}}</view>
    </view>
  </view>

  <view wx:if="{{!result}}" class="button-primary submit-button" bindtap="submitAnswer">提交答案</view>

  <view wx:if="{{result}}" class="card result-card">
    <view class="result-title {{result.correct ? 'correct' : 'wrong'}}">{{result.correct ? '猜对了' : '猜错了'}}</view>
    <view class="muted">{{result.message}}</view>
    <view class="result-actions">
      <view class="button-secondary" bindtap="openAnswer">查看详情</view>
      <view class="button-primary" bindtap="nextQuiz">再猜一题</view>
    </view>
  </view>
</view>
