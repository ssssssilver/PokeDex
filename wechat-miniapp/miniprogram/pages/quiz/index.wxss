.quiz-card {
  padding: 28rpx;
  text-align: center;
}

.quiz-title {
  margin-top: 8rpx;
  color: #101828;
  font-size: 42rpx;
  font-weight: 900;
}

.silhouette {
  width: 240rpx;
  height: 240rpx;
  margin-top: 20rpx;
  filter: brightness(0);
  opacity: 0.72;
}

.silhouette.revealed {
  filter: none;
  opacity: 1;
}

.hint-card {
  margin-top: 18rpx;
  padding: 22rpx;
}

.hint-row {
  padding: 10rpx 0;
  color: #334155;
  font-size: 26rpx;
}

.option-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.option-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 132rpx;
  padding: 18rpx;
  text-align: center;
}

.option-card.active {
  border-color: #0f766e;
  background: #e6fffb;
}

.option-name {
  color: #182230;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.submit-button {
  margin-top: 22rpx;
}

.result-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.result-title {
  color: #182230;
  font-size: 34rpx;
  font-weight: 900;
}

.result-title.correct {
  color: #0f766e;
}

.result-title.wrong {
  color: #b42318;
}

.result-button {
  margin-top: 18rpx;
}
