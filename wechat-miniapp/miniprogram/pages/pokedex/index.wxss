.pokedex-page {
  padding-bottom: 48rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-inline {
  flex: 1;
  min-width: 0;
}

.filter-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 0 0 auto;
  min-width: 112rpx;
  min-height: 76rpx;
  border: 1rpx solid #d9e2ec;
  border-radius: 14rpx;
  background: #ffffff;
  color: #334155;
  font-size: 26rpx;
  font-weight: 800;
}

.filter-trigger.active {
  border-color: #0f766e;
  color: #0f766e;
}

.filter-count {
  min-width: 30rpx;
  height: 30rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.applied-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}

.applied-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
}

.applied-reset {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
}

.result-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 4rpx 14rpx;
  color: #334155;
  font-size: 24rpx;
  font-weight: 800;
}

.loading-state {
  padding: 36rpx;
  color: #697586;
  text-align: center;
}

.pokemon-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.pokemon-row {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  padding: 16rpx 18rpx;
}

.row-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.sprite-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  margin-right: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.sprite-wrap image {
  width: 96rpx;
  height: 96rpx;
}

.row-copy {
  flex: 1;
  min-width: 0;
}

.row-topline,
.row-facts {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.dex-number {
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
}

.generation-pill {
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 20rpx;
  font-weight: 700;
}

.row-name {
  overflow: hidden;
  margin-top: 4rpx;
  color: #182230;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-subtitle {
  overflow: hidden;
  color: #697586;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-types {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.row-facts {
  margin-top: 10rpx;
  color: #465467;
  font-size: 22rpx;
}

.row-facts text {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
}

.favorite {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex: 0 0 auto;
  width: 58rpx;
  padding-top: 6rpx;
  color: #cbd5e1;
  font-size: 38rpx;
  line-height: 1;
}

.favorite.liked {
  color: #f59e0b;
}

.load-more-state {
  padding: 24rpx 0 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
  text-align: center;
}

.filter-mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 23, 42, 0.46);
}

.filter-panel {
  position: fixed;
  z-index: 90;
  top: 110rpx;
  right: 24rpx;
  left: 24rpx;
  overflow: hidden;
  max-height: 78vh;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.18);
}

.filter-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx 12rpx;
}

.filter-panel-title {
  color: #182230;
  font-size: 30rpx;
  font-weight: 900;
}

.filter-close {
  color: #697586;
  font-size: 24rpx;
  font-weight: 800;
}

.filter-panel-body {
  max-height: 58vh;
  padding: 0 24rpx 18rpx;
  box-sizing: border-box;
}

.filter-section-title {
  margin: 22rpx 0 12rpx;
  color: #465467;
  font-size: 24rpx;
  font-weight: 800;
}

.filter-grid {
  display: grid;
  gap: 12rpx;
}

.type-grid {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.generation-grid,
.region-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.sort-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.filter-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #f8fafc;
  color: #182230;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.filter-option.selected {
  background: #0f766e;
  color: #ffffff;
}

.filter-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 16rpx 24rpx 22rpx;
  border-top: 1rpx solid #eef2f6;
}

.filter-clear,
.filter-confirm {
  min-height: 64rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.filter-clear {
  border: 1rpx solid #cbd5e1;
  color: #334155;
}

.filter-confirm {
  background: #0f766e;
  color: #ffffff;
}
