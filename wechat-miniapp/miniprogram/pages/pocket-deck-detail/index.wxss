.pocket-deck-detail { padding-bottom: 120rpx; }.detail-state { padding: 58rpx 20rpx; border: 1rpx solid #e1e7ec; background: #fff; color: #64748b; text-align: center; }.detail-state.error { color: #b42318; }.deck-head { display: flex; align-items: center; padding: 22rpx; background: #182230; color: #fff; }.deck-rank { display: flex; align-items: center; justify-content: center; flex: 0 0 64rpx; height: 64rpx; border: 2rpx solid #5eead4; border-radius: 50%; color: #5eead4; font-size: 22rpx; font-weight: 900; }.deck-head-copy { flex: 1; min-width: 0; margin-left: 16rpx; }.deck-title { font-size: 31rpx; font-weight: 900; line-height: 1.25; }.deck-sub { margin-top: 5rpx; color: #cbd5e1; font-size: 20rpx; }.deck-energy { margin-left: 12rpx; text-align: right; }.deck-energy text { display: block; color: #94a3b8; font-size: 18rpx; }.deck-energy strong { display: block; margin-top: 4rpx; color: #f5c84b; font-size: 22rpx; }.deck-metrics { display: grid; grid-template-columns: repeat(3,1fr); border-right: 1rpx solid #e1e7ec; border-bottom: 1rpx solid #e1e7ec; background: #fff; }.deck-metrics view { padding: 17rpx 8rpx; border-left: 1rpx solid #e1e7ec; text-align: center; }.deck-metrics strong,.deck-metrics text { display: block; }.deck-metrics strong { color: #0f766e; font-size: 26rpx; }.deck-metrics text { margin-top: 3rpx; color: #718096; font-size: 18rpx; }.section-title { margin-top: 24rpx; }.deck-card-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; }.deck-card { position: relative; min-width: 0; padding: 9rpx; border: 1rpx solid #e1e7ec; border-radius: 12rpx; background: #fff; box-sizing: border-box; }.deck-card-art { display: flex; align-items: center; justify-content: center; width: 100%; aspect-ratio: 5 / 7; border-radius: 7rpx; background: #f3f6f8; }.deck-card-art image { width: 96%; height: 96%; }.count-badge { position: absolute; top: 14rpx; right: 14rpx; min-width: 36rpx; height: 36rpx; padding: 0 5rpx; border-radius: 18rpx; background: #182230; color: #fff; font-size: 18rpx; font-weight: 900; line-height: 36rpx; text-align: center; box-sizing: border-box; }.deck-card-name,.deck-card-set { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.deck-card-name { margin-top: 7rpx; color: #182230; font-size: 20rpx; font-weight: 800; }.deck-card-set { margin-top: 2rpx; color: #7b8794; font-size: 17rpx; }.source-line { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 20rpx; padding: 16rpx 0; border-top: 1rpx solid #e1e7ec; color: #64748b; font-size: 19rpx; }.source-line text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.copy-bar { position: fixed; z-index: 30; right: 24rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); left: 24rpx; min-height: 72rpx; border-radius: 11rpx; background: #0f766e; color: #fff; font-size: 26rpx; font-weight: 900; line-height: 72rpx; text-align: center; box-shadow: 0 10rpx 24rpx rgba(15,118,110,.2); }

.deck-main-icons { display: flex; flex: 0 0 82rpx; margin-left: 12rpx; }
.deck-main-icons image { width: 52rpx; height: 52rpx; margin-right: -18rpx; }

