.events-page { padding-bottom: 44rpx; }.event-tabs { margin: -4rpx 0 20rpx; white-space: nowrap; }.event-tab { display: inline-flex; align-items: center; justify-content: center; min-width: 116rpx; min-height: 58rpx; margin-right: 10rpx; border: 1rpx solid #dce3e9; border-radius: 10rpx; background: #fff; color: #64748b; font-size: 23rpx; font-weight: 800; }.event-tab.active { border-color: #182230; background: #182230; color: #fff; }.event-cards { display: flex; flex-direction: column; gap: 14rpx; }.event-card { padding: 20rpx; border: 1rpx solid #e1e7ec; border-radius: 14rpx; background: #fff; }.event-top { display: flex; align-items: center; justify-content: space-between; }.event-type { padding: 5rpx 11rpx; border-radius: 7rpx; background: #dff8f4; color: #0f766e; font-size: 20rpx; font-weight: 900; }.event-status { color: #0f766e; font-size: 20rpx; font-weight: 800; }.event-status.upcoming { color: #b7791f; }.event-name { margin-top: 14rpx; color: #182230; font-size: 30rpx; font-weight: 900; line-height: 1.35; }.event-range { margin-top: 7rpx; color: #64748b; font-size: 22rpx; }.event-more { margin-top: 16rpx; color: #0f766e; font-size: 22rpx; font-weight: 800; }.event-detail { margin-top: 12rpx; padding: 12rpx 14rpx; border-left: 5rpx solid #0f766e; background: #f4f7f8; color: #465467; font-size: 22rpx; line-height: 1.7; }.event-state { padding: 54rpx 20rpx; border: 1rpx solid #e1e7ec; border-radius: 14rpx; background: #fff; color: #64748b; text-align: center; }.event-state.error { color: #b42318; }
