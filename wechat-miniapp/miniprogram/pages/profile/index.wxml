<view class="page profile-page">
  <view class="profile-heading">
    <view class="profile-title">我的图鉴数据</view>
    <view class="muted">收藏、拥有状态与队伍保存在当前微信设备</view>
  </view>

  <view class="domain-section">
    <view class="domain-head">
      <view class="domain-mark pokemon">宝</view>
      <view><view class="domain-title">宝可梦</view><view class="muted">图鉴收藏与队伍</view></view>
      <view class="domain-link" bindtap="openPokedex">进入图鉴</view>
    </view>
    <view class="stats-grid">
      <view bindtap="openPokedex"><view class="stat-value">{{pokemonStats.favorites}}</view><text>收藏</text></view>
      <view bindtap="openTeam"><view class="stat-value">{{pokemonStats.teams}}</view><text>队伍</text></view>
      <view bindtap="openQuiz"><view class="stat-value">{{pokemonStats.quizCount}}</view><text>猜谜记录</text></view>
    </view>
    <view class="team-list">
      <view wx:for="{{teams}}" wx:key="id" class="team-row" bindtap="openTeam">
        <view class="team-index">{{index + 1}}</view>
        <view class="team-copy"><view>{{item.name}}</view><text>{{item.memberCount ? '已保存队伍成员' : '等待添加宝可梦'}}</text></view>
        <view class="team-count">{{item.memberText}}</view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="domain-section">
    <view class="domain-head">
      <view class="domain-mark cardmark">卡</view>
      <view><view class="domain-title">实体卡牌</view><view class="muted">收藏、拥有与愿望单</view></view>
      <view class="domain-link" bindtap="openCarddex">进入图鉴</view>
    </view>
    <view class="stats-grid">
      <view bindtap="openCarddex"><view class="stat-value">{{cardStats.favorites}}</view><text>收藏</text></view>
      <view bindtap="openCarddex"><view class="stat-value">{{cardStats.owned}}</view><text>已拥有</text></view>
      <view bindtap="openCarddex"><view class="stat-value">{{cardStats.wishlist}}</view><text>愿望单</text></view>
    </view>
  </view>

  <view class="domain-section">
    <view class="domain-head">
      <view class="domain-mark pocket">P</view>
      <view><view class="domain-title">Pocket</view><view class="muted">移动端卡牌收藏</view></view>
      <view class="domain-link" bindtap="openPocket">进入图鉴</view>
    </view>
    <view class="stats-grid two-columns">
      <view bindtap="openPocket"><view class="stat-value">{{pocketStats.favorites}}</view><text>收藏</text></view>
      <view bindtap="openPocket"><view class="stat-value">{{pocketStats.owned}}</view><text>已拥有</text></view>
    </view>
  </view>

  <view class="settings-section">
    <view class="section-label">更多</view>
    <view class="settings-list">
      <view class="settings-row" bindtap="openPlay">
        <view class="settings-icon">玩</view><view class="settings-copy"><view class="settings-title">玩法盒子</view><text>查看全部轻玩法</text></view><view class="row-arrow">›</view>
      </view>
      <button class="settings-row feedback-button" open-type="feedback">
        <view class="settings-icon support">意</view><view class="settings-copy"><view class="settings-title">用户意见反馈</view><text>通过微信反馈问题或建议</text></view><view class="row-arrow">›</view>
      </button>
      <view class="settings-row version-row">
        <view class="settings-icon version">版</view><view class="settings-copy"><view class="settings-title">版本号</view><text>宝批小站</text></view><view class="version-value">v{{version}}</view>
      </view>
    </view>
  </view>
</view>
