<view class="page profile-page">
  <view class="card profile-card">
    <view>
      <view class="muted">宝可梦图鉴进度</view>
      <view class="profile-title">{{progress}} / {{total}}</view>
    </view>
    <view class="button-primary" bindtap="openPokedex">继续探索</view>
  </view>

  <view class="card profile-card">
    <view>
      <view class="muted">卡牌收藏 / 拥有</view>
      <view class="profile-title">{{cardProgress}} / {{ownedCount}}</view>
      <view class="muted">卡牌缓存 {{cardTotal}} 张</view>
    </view>
    <view class="button-primary" bindtap="openCarddex">看卡牌</view>
  </view>

  <view wx:if="{{syncStatus}}" class="card data-card">
    <view class="data-head">
      <view>
        <view class="muted">数据源</view>
        <view class="data-title">{{syncStatus.label}}</view>
      </view>
      <view class="data-pill {{syncStatus.healthTone}}">{{syncStatus.healthLabel}}</view>
    </view>
    <view class="data-grid">
      <view>
        <view class="muted">可用数量</view>
        <view>{{syncStatus.total}}</view>
      </view>
      <view>
        <view class="muted">最近同步</view>
        <view>{{syncStatus.syncedAtText}}</view>
      </view>
      <view>
        <view class="muted">同步健康</view>
        <view>{{syncStatus.syncAgeText}} / {{syncStatus.maxSyncAgeHours}}h</view>
      </view>
      <view>
        <view class="muted">可用</view>
        <view>{{syncStatus.syncedCount}}</view>
      </view>
      <view>
        <view class="muted">图片缓存</view>
        <view>{{syncStatus.imageCachedCount}} / {{syncStatus.imageCacheFailedCount}}</view>
      </view>
      <view>
        <view class="muted">最后同步</view>
        <view>{{syncStatus.lastRunSyncedCount}}</view>
      </view>
      <view>
        <view class="muted">失败</view>
        <view>{{syncStatus.failedCount}}</view>
      </view>
    </view>
    <view wx:if="{{syncRuns.length}}" class="run-list">
      <view class="run-title">最近同步记录</view>
      <view wx:for="{{syncRuns}}" wx:key="key" class="run-row">
        <view>
          <view class="run-main">{{item.rangeText}} · {{item.statusText}}</view>
          <view class="muted">{{item.timeText}}</view>
        </view>
        <view class="run-metrics">
          <view>{{item.countText}}</view>
          <view class="muted">图片 {{item.imageText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{ptcgStatus}}" class="card data-card">
    <view class="data-head">
      <view>
        <view class="muted">卡牌数据源</view>
        <view class="data-title">{{ptcgStatus.label}}</view>
      </view>
      <view class="data-pill {{ptcgStatus.healthTone}}">{{ptcgStatus.healthLabel}}</view>
    </view>
    <view class="data-grid">
      <view>
        <view class="muted">卡牌数量</view>
        <view>{{ptcgStatus.total}}</view>
      </view>
      <view>
        <view class="muted">系列数量</view>
        <view>{{ptcgStatus.setTotal}}</view>
      </view>
      <view>
        <view class="muted">最近同步</view>
        <view>{{ptcgStatus.syncedAtText}}</view>
      </view>
      <view>
        <view class="muted">失败</view>
        <view>{{ptcgStatus.failedCount}}</view>
      </view>
    </view>
    <view wx:if="{{ptcgRuns.length}}" class="run-list">
      <view class="run-title">最近卡牌同步</view>
      <view wx:for="{{ptcgRuns}}" wx:key="key" class="run-row">
        <view>
          <view class="run-main">卡牌 {{item.cardText}} · {{item.statusText}}</view>
          <view class="muted">{{item.timeText}}</view>
        </view>
        <view class="run-metrics">
          <view>系列 {{item.setText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card play-entry-card">
    <view>
      <view class="muted">轻玩法</view>
      <view class="check-title">猜谜、队伍分析和属性速查</view>
    </view>
    <view class="button-secondary" bindtap="openPlay">进入</view>
  </view>

  <view class="card check-card">
    <view class="check-head">
      <view>
        <view class="muted">云缓存自检</view>
        <view class="check-title">{{cacheCheck ? cacheCheck.title : '等待检查'}}</view>
      </view>
      <view class="button-primary check-button" bindtap="runCacheCheck">{{cacheCheckButtonText}}</view>
    </view>
    <view wx:if="{{cacheCheck}}" class="check-body">
      <view class="data-pill {{cacheCheck.tone}}">{{cacheCheck.label}}</view>
      <view class="check-grid">
        <view>
          <view class="muted">数量</view>
          <view>{{cacheCheck.countText}}</view>
        </view>
        <view>
          <view class="muted">同步年龄</view>
          <view>{{cacheCheck.syncText}}</view>
        </view>
        <view>
          <view class="muted">问题</view>
          <view>{{cacheCheck.issueText}}</view>
        </view>
        <view>
          <view class="muted">来源</view>
          <view>{{cacheCheck.sourceText}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>我的收藏</text>
      <text class="muted">{{favorites.length}} 只</text>
    </view>
    <view wx:if="{{favorites.length}}" class="mini-list">
      <view wx:for="{{favorites}}" wx:key="id" class="mini-row card" data-id="{{item.id}}" bindtap="openPokemon">
        <image src="{{item.image}}" mode="aspectFit" />
        <view>
          <view class="mini-name">{{item.name_zh}}</view>
          <view class="muted">#{{item.id}} {{item.name_en}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="card empty-state">
      <view class="title">还没有收藏</view>
      <view class="hint">在详情页或图鉴列表点星标收藏。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>我的卡牌收藏</text>
      <text class="muted">{{cardFavorites.length}} 张</text>
    </view>
    <view wx:if="{{cardFavorites.length}}" class="mini-list">
      <view wx:for="{{cardFavorites}}" wx:key="id" class="mini-row card" data-id="{{item.id}}" bindtap="openCard">
        <image class="card-mini-art" src="{{item.image}}" mode="aspectFit" />
        <view>
          <view class="mini-name">{{item.display_name || item.name_zh || item.name}}</view>
          <view class="muted">{{item.set_name}} #{{item.number}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="card empty-state">
      <view class="title">还没有收藏卡牌</view>
      <view class="hint">在卡牌详情或卡牌图鉴里点星标收藏。</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>最近查看</text>
    </view>
    <view wx:if="{{recent.length}}" class="mini-list">
      <view wx:for="{{recent}}" wx:key="id" class="mini-row card" data-id="{{item.id}}" bindtap="openPokemon">
        <image src="{{item.image}}" mode="aspectFit" />
        <view>
          <view class="mini-name">{{item.name_zh}}</view>
          <view class="muted">#{{item.id}} {{item.name_en}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>最近看卡</text>
    </view>
    <view wx:if="{{recentCards.length}}" class="mini-list">
      <view wx:for="{{recentCards}}" wx:key="id" class="mini-row card" data-id="{{item.id}}" bindtap="openCard">
        <image class="card-mini-art" src="{{item.image}}" mode="aspectFit" />
        <view>
          <view class="mini-name">{{item.display_name}}</view>
          <view class="muted">{{item.set_name}} #{{item.number}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
