.deck-detail-page {
  padding-bottom: 48rpx;
}

.loading-card {
  padding: 48rpx 32rpx;
  text-align: center;
}

.loading-title {
  margin-bottom: 8rpx;
  color: #182230;
  font-size: 32rpx;
  font-weight: 900;
}

.deck-hero {
  padding: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #eefbf8 100%);
}

.deck-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.deck-rank,
.deck-source {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.deck-rank {
  background: #0f766e;
  color: #ffffff;
}

.deck-source {
  background: #ffffff;
  color: #0f766e;
}

.deck-title {
  margin-top: 18rpx;
  color: #101828;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.22;
}

.deck-description {
  margin-top: 10rpx;
  color: #465467;
  font-size: 24rpx;
  line-height: 1.55;
}

.deck-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.deck-meta-item {
  min-height: 96rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid #d9f3ee;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.82);
  text-align: center;
  box-sizing: border-box;
}

.meta-value {
  overflow: hidden;
  color: #101828;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.latest-result {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.82);
}

.latest-label {
  flex: 0 0 auto;
  color: #697586;
  font-size: 22rpx;
  font-weight: 700;
}

.latest-value {
  overflow: hidden;
  color: #182230;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deck-hero-icons {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.deck-hero-icons image {
  width: 64rpx;
  height: 64rpx;
}

.deck-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.deck-actions .button-primary,
.deck-actions .button-secondary,
.copy-panel .button-primary {
  width: 100%;
  box-sizing: border-box;
}

.deck-gallery-section {
  overflow: hidden;
}

.deck-gallery-scroll {
  width: 100%;
  white-space: nowrap;
}

.deck-gallery-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 2rpx 2rpx 10rpx;
}

.deck-gallery-item {
  display: inline-flex;
  flex-direction: column;
  width: 166rpx;
  vertical-align: top;
}

.deck-card-thumb-wrap {
  position: relative;
  width: 166rpx;
  height: 232rpx;
  border-radius: 10rpx;
  background: #eef2f6;
}

.deck-card-thumb {
  width: 166rpx;
  height: 232rpx;
  border-radius: 10rpx;
}

.deck-card-quantity {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 42rpx;
  height: 38rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(15, 118, 110, 0.94);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-align: center;
  box-sizing: border-box;
}

.deck-gallery-name {
  overflow: hidden;
  margin-top: 10rpx;
  color: #182230;
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deck-gallery-set {
  overflow: hidden;
  margin-top: 2rpx;
  color: #697586;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deck-section-card {
  padding: 0 18rpx;
}

.deck-card-row {
  display: flex;
  align-items: center;
  min-height: 76rpx;
  border-bottom: 1rpx solid #eef2f6;
}

.deck-card-row:last-child {
  border-bottom: 0;
}

.deck-card-count {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 54rpx;
  width: 54rpx;
  height: 42rpx;
  margin-right: 18rpx;
  border-radius: 12rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
}

.deck-card-main {
  flex: 1;
  min-width: 0;
}

.deck-card-name {
  overflow: hidden;
  color: #182230;
  font-size: 28rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-panel {
  margin-top: 28rpx;
}

.retry-button {
  margin-top: 24rpx;
}
