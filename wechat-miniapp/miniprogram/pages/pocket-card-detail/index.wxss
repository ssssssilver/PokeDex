.pocket-detail-page { padding-bottom: 130rpx; }.detail-state { padding: 60rpx 20rpx; border: 1rpx solid #e4e9ef; border-radius: 14rpx; background: #fff; color: #64748b; text-align: center; }.detail-state.error { color: #b42318; }
.detail-top { display: flex; align-items: center; gap: 24rpx; padding: 22rpx; border-bottom: 1rpx solid #dfe5eb; background: #fff; }.detail-art { display: flex; align-items: center; justify-content: center; flex: 0 0 224rpx; height: 312rpx; border-radius: 12rpx; background: #f3f6f8; }.detail-art image { width: 214rpx; height: 302rpx; }.detail-copy { flex: 1; min-width: 0; }.detail-code { color: #0f766e; font-size: 21rpx; font-weight: 900; }.detail-name { margin-top: 8rpx; color: #172033; font-size: 38rpx; font-weight: 900; line-height: 1.2; }.detail-en { margin-top: 5rpx; color: #64748b; font-size: 23rpx; }.detail-badges { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 18rpx; }.detail-badges text { padding: 5rpx 12rpx; border-radius: 8rpx; color: #fff; font-size: 20rpx; font-weight: 900; }.detail-badges .rarity { background: #b7791f; }.detail-badges .ex { background: #c2413b; }
.detail-section { margin-top: 20rpx; border-top: 1rpx solid #e4e9ef; border-bottom: 1rpx solid #e4e9ef; background: #fff; }.section-heading { padding: 20rpx 22rpx 12rpx; color: #182230; font-size: 28rpx; font-weight: 900; }.stats-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); padding: 0 22rpx 20rpx; }.stats-grid > view { min-height: 84rpx; padding: 12rpx; border: 1rpx solid #edf0f3; box-sizing: border-box; }.stats-grid text { display: block; color: #718096; font-size: 20rpx; }.stats-grid strong { display: block; margin-top: 6rpx; color: #182230; font-size: 25rpx; font-weight: 900; }
.move-row { padding: 18rpx 22rpx; border-top: 1rpx solid #edf0f3; }.move-head { display: flex; align-items: center; gap: 12rpx; }.move-name { flex: 1; color: #182230; font-size: 27rpx; font-weight: 900; }.move-damage { color: #b42318; font-size: 29rpx; font-weight: 900; }.move-text { margin-top: 10rpx; color: #465467; font-size: 23rpx; line-height: 1.6; }.ability-label { padding: 4rpx 10rpx; border-radius: 7rpx; background: #b45088; color: #fff; font-size: 19rpx; font-weight: 900; }.energy-line { display: flex; align-items: center; gap: 5rpx; min-height: 35rpx; }.energy { display: flex!important; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 0!important; border-radius: 50%; color: #fff!important; font-size: 17rpx!important; font-weight: 900; }
.weakness-energy { display: flex; align-items: center; gap: 8rpx; margin-top: 6rpx; }.weakness-energy strong { margin-top: 0; }
.collection-list,.acquisition-list { padding: 0 22rpx 18rpx; }.collection-row,.acquisition-list view { display: flex; align-items: center; justify-content: space-between; min-height: 58rpx; border-top: 1rpx solid #edf0f3; color: #334155; font-size: 22rpx; }.collection-row text:last-child,.acquisition-list text:last-child { color: #64748b; }
.related-pokemon { display: flex; align-items: center; min-height: 116rpx; padding: 8rpx 22rpx 18rpx; }.related-pokemon image { flex: 0 0 auto; width: 96rpx; height: 96rpx; margin-right: 18rpx; }.related-pokemon > view { flex: 1; min-width: 0; }.related-pokemon strong,.related-pokemon text { display: block; }.related-pokemon strong { color: #182230; font-size: 28rpx; }.related-pokemon text { margin-top: 4rpx; color: #64748b; font-size: 22rpx; }.related-pokemon .related-arrow { flex: 0 0 auto; color: #0f766e; font-size: 42rpx; }
.detail-actions { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: 1fr 1.4fr; gap: 12rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #dfe5eb; background: #fff; }.detail-actions view { min-height: 70rpx; border-radius: 10rpx; font-size: 25rpx; font-weight: 900; line-height: 70rpx; text-align: center; }.action-secondary { border: 1rpx solid #cbd5e1; color: #475569; }.action-secondary.active { border-color: #b7791f; color: #b7791f; }.action-primary { background: #0f766e; color: #fff; }.action-primary.owned { background: #dff8f4; color: #0f766e; }
