<view class="page carddex-page">
  <view class="search-row">
    <view class="search-box search-inline"><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="submitSearch" confirm-type="search" placeholder="搜索卡牌、宝可梦、扩展包、编号或画师" /></view>
    <view class="filter-trigger {{filterCount ? 'active' : ''}}" bindtap="openFilter"><text>筛选</text><text wx:if="{{filterCount}}" class="filter-count">{{filterCount}}</text></view>
  </view>

  <view wx:if="{{filterCount}}" class="applied-row">
    <view wx:if="{{activePokemonId}}" class="applied-chip">关联 #{{activePokemonId}}</view>
    <view wx:if="{{activeType}}" class="applied-chip">{{activeType === 'pokemon' ? '宝可梦' : '训练家'}}</view>
    <view wx:if="{{activeExpansion}}" class="applied-chip">{{activeExpansion}}</view>
    <view wx:if="{{activeRarity}}" class="applied-chip">{{activeRarity}}</view>
    <view wx:if="{{activeSort !== 'set'}}" class="applied-chip">已排序</view>
    <view class="applied-reset" bindtap="resetFilters">重置</view>
  </view>

  <view class="result-meta"><text>{{cards.length}} / {{total}} 张卡牌</text><text class="muted">Pocket 数据</text></view>
  <view wx:if="{{loading && !cards.length}}" class="card loading-state">Pocket 图鉴加载中</view>
  <view wx:elif="{{error && !cards.length}}" class="card empty-state" bindtap="submitSearch"><view class="title">{{error}}</view></view>

  <view wx:elif="{{cards.length}}" class="card-list">
    <view wx:for="{{cards}}" wx:key="id" class="card-row card">
      <view class="row-main" data-id="{{item.id}}" bindtap="openCard">
        <view class="card-art-wrap"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" lazy-load="true" /><view wx:else class="card-art-empty">CARD</view></view>
        <view class="row-copy">
          <view class="row-topline"><text class="set-number">{{item.collection.expansion_id}} #{{item.collection.number}}</text><text wx:if="{{item.is_ex}}" class="regulation-pill">ex</text></view>
          <view class="row-name">{{item.title}}</view>
          <view wx:if="{{item.subtitle}}" class="row-subtitle">{{item.subtitle}}</view>
          <view class="row-facts"><text>{{item.setText}}</text><text wx:if="{{item.metaText}}">{{item.metaText}}</text></view>
          <view wx:if="{{item.typeBadges.length}}" class="energy-row"><energy-icon wx:for="{{item.typeBadges}}" wx:key="id" type="{{item.iconType}}" label="{{item.name}}能量" /></view>
        </view>
      </view>
      <view class="row-actions">
        <view class="mini-action {{item.favorite ? 'active' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.favorite ? '★' : '☆'}}</view>
        <view class="mini-owned {{item.owned ? 'active' : ''}}" data-id="{{item.id}}" catchtap="toggleOwned">{{item.owned ? '有' : '收'}}</view>
      </view>
    </view>
  </view>

  <view wx:else class="card empty-state"><view class="title">没有找到卡牌</view><view class="hint">换个名称、扩展包、编号或稀有度试试。</view></view>
  <view wx:if="{{loadingMore}}" class="load-more-state">继续加载中</view><view wx:elif="{{cards.length && !hasMore}}" class="load-more-state">已加载全部</view>

  <view wx:if="{{filterVisible}}" class="filter-mask" catchtap="closeFilter"></view>
  <view wx:if="{{filterVisible}}" class="filter-panel" catchtap="stopTap">
    <view class="filter-panel-head"><view class="filter-panel-title">Pocket 卡牌筛选</view><view class="filter-close" bindtap="closeFilter">关闭</view></view>
    <scroll-view scroll-y class="filter-panel-body">
      <view class="filter-section-title">卡牌大类</view>
      <view class="filter-grid two-grid"><view wx:for="{{filterTypes}}" wx:key="id" class="filter-option {{item.selected ? 'selected' : ''}}" data-field="Type" data-id="{{item.id}}" bindtap="selectDraft">{{item.name}}</view></view>
      <view class="filter-section-title">扩展包</view>
      <view class="filter-grid two-grid"><view wx:for="{{filterExpansions}}" wx:key="id" class="filter-option pocket-set-option {{item.selected ? 'selected' : ''}}" data-field="Expansion" data-id="{{item.id}}" bindtap="selectDraft"><text>{{item.code}}</text><view>{{item.name}}</view></view></view>
      <view class="filter-section-title">稀有度</view>
      <view class="filter-grid three-grid"><view wx:for="{{filterRarities}}" wx:key="id" class="filter-option {{item.selected ? 'selected' : ''}}" data-field="Rarity" data-id="{{item.id}}" bindtap="selectDraft">{{item.id}}</view></view>
      <view class="filter-section-title">排序</view>
      <view class="filter-grid two-grid"><view wx:for="{{filterSorts}}" wx:key="id" class="filter-option {{item.selected ? 'selected' : ''}}" data-field="Sort" data-id="{{item.id}}" bindtap="selectDraft">{{item.name}}</view></view>
    </scroll-view>
    <view class="filter-actions"><view class="filter-clear" bindtap="clearDraft">清空</view><view class="filter-confirm" bindtap="confirmFilter">确定</view></view>
  </view>
</view>
