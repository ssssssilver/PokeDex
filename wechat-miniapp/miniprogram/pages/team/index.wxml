<view class="page team-page">
  <view class="team-switcher">
    <scroll-view scroll-x class="team-tabs"><view class="team-tab-row"><view wx:for="{{teams}}" wx:key="id" class="team-tab {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTeam"><text>{{item.name}}</text><small>{{item.count}} / 6</small></view></view></scroll-view>
    <view class="add-team" bindtap="createTeam">＋</view>
  </view>

  <view class="card team-summary">
    <view><view class="muted">当前队伍</view><view class="active-team-name">{{activeTeamName}}</view><view class="team-count">{{selectedIds.length}} / 6</view></view>
    <view class="team-commands"><view bindtap="renameTeam">重命名</view><view class="danger" bindtap="deleteTeam">删除</view></view>
    <view wx:if="{{analysis}}" class="score">{{analysis.score}}</view>
  </view>

  <view class="selected-strip">
    <view wx:for="{{teamSlots}}" wx:key="index" class="selected-slot {{item.pokemon ? 'filled' : ''}}">
      <block wx:if="{{item.pokemon}}"><image src="{{item.pokemon.image}}" mode="aspectFit" data-id="{{item.pokemon.id}}" bindtap="openPokemon" /><view class="slot-remove" data-id="{{item.pokemon.id}}" catchtap="removeMember">×</view><text>{{item.pokemon.name_zh}}</text></block>
      <text wx:else class="slot-empty">+</text>
    </view>
  </view>

  <view wx:if="{{analysis}}" class="card analysis-card">
    <view class="analysis-text">{{analysis.summary}}</view>
    <view class="analysis-section"><view class="analysis-title">主要弱点</view><view wx:if="{{analysis.weaknesses.length}}" class="tag-line"><view wx:for="{{analysis.weaknesses}}" wx:key="id" class="soft-tag weakness-tag">{{item.name}} × {{item.count}}</view></view><view wx:else class="analysis-empty">暂无明显共同弱点</view></view>
    <view class="analysis-section"><view class="analysis-title">抗性覆盖</view><view wx:if="{{analysis.resistances.length}}" class="tag-line"><view wx:for="{{analysis.resistances}}" wx:key="id" class="soft-tag resistance-tag">{{item.name}} × {{item.count}}</view></view><view wx:else class="analysis-empty">暂无抗性覆盖</view></view>
    <view wx:if="{{analysis.immunities.length}}" class="analysis-section"><view class="analysis-title">免疫覆盖</view><view class="tag-line"><view wx:for="{{analysis.immunities}}" wx:key="id" class="soft-tag immunity-tag">{{item.name}} × {{item.count}}</view></view></view>
  </view>
  <view wx:else class="card team-empty-analysis">添加宝可梦后显示队伍属性分析</view>

  <view class="section">
    <view class="section-title"><text>选择成员</text><text class="muted">点击加入或移除</text></view>
    <view class="team-list"><view wx:for="{{pokemon}}" wx:key="id" class="member-card card {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" bindtap="toggleMember"><image src="{{item.image}}" mode="aspectFit" /><view class="member-main"><view class="member-name">{{item.name_zh}}</view><view class="muted">#{{item.id}} {{item.name_en}}</view><view class="member-types"><view wx:for="{{item.types}}" wx:for-item="type" wx:for-index="typeIndex" wx:key="*this" class="type-badge type-{{type}}">{{item.typeNames[typeIndex]}}</view></view></view><view class="member-mark">{{item.selected ? '✓' : '+'}}</view></view></view>
  </view>
</view>
