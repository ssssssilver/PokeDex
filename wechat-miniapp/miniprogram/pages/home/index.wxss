.home-banner {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 1;
  margin: 6rpx 0 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #168fe8;
}

.home-banner image {
  width: 100%;
  height: 100%;
}

.home-banner-title {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
  text-shadow: 0 3rpx 0 #153d86, 2rpx 0 0 #153d86, -2rpx 0 0 #153d86;
  white-space: nowrap;
}

.home-search {
  margin-bottom: 0;
}

.home-quick-section {
  margin-top: 24rpx;
  margin-bottom: 28rpx;
}

.search-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.search-tabs.three-tabs {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.search-tab.active.pocket {
  background: #182230;
}

.quick-icon.coral { background: #fff0ee; color: #dc5148; }
.quick-icon.gold { background: #fff7df; color: #a56b00; }
.quick-icon.blue { background: #eaf2ff; color: #2f6fc2; }
.quick-icon.ink { background: #edf0f4; color: #293445; }

.pocket-home-card {
  display: flex;
  align-items: center;
  min-height: 224rpx;
  padding: 20rpx;
  border: 1rpx solid #dce5eb;
  border-left: 8rpx solid #0f766e;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.pocket-home-art {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 132rpx;
  height: 184rpx;
  border-radius: 10rpx;
  background: #f3f6f8;
}

.pocket-home-art image { width: 124rpx; height: 176rpx; }
.pocket-home-copy { flex: 1; min-width: 0; margin-left: 20rpx; }
.pocket-label { color: #0f766e; font-size: 22rpx; font-weight: 800; }
.pocket-name { overflow: hidden; margin-top: 7rpx; color: #182230; font-size: 34rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.pocket-en { margin-top: 3rpx; color: #64748b; font-size: 22rpx; }
.pocket-meta { margin-top: 12rpx; color: #475569; font-size: 21rpx; }
.pocket-arrow { color: #94a3b8; font-size: 42rpx; }

.pocket-event-list,
.pocket-deck-list { border-top: 1rpx solid #e1e7ec; }

.pocket-event-row,
.pocket-deck-row {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid #e1e7ec;
}

.pocket-event-row > text,
.pocket-deck-row > text {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 76rpx;
  min-height: 42rpx;
  border-radius: 8rpx;
  background: #e6f7f4;
  color: #0f766e;
  font-size: 19rpx;
  font-weight: 900;
}

.pocket-event-row > view,
.pocket-deck-row > view { flex: 1; min-width: 0; margin-left: 14rpx; }
.pocket-event-row strong,
.pocket-deck-row strong { display: block; overflow: hidden; color: #182230; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.pocket-event-row view view,
.pocket-deck-row view view { margin-top: 3rpx; color: #718096; font-size: 19rpx; }

.pocket-deck-row > .home-pocket-deck-icons { display: flex; flex: 0 0 88rpx; min-width: 88rpx; margin-left: 10rpx; }
.home-pocket-deck-icons image { width: 52rpx; height: 52rpx; margin-right: -16rpx; }
.pocket-deck-row > .home-pocket-deck-icons + view { margin-left: 10rpx; }

.search-tab {
  min-height: 54rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #697586;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.search-tab.active {
  background: #0f766e;
  color: #ffffff;
}

.search-action {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 280rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8fff7 100%);
}

.hero-copy {
  flex: 1;
}

.hero-name {
  margin-top: 8rpx;
  color: #101828;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-en {
  margin-top: 6rpx;
  color: #697586;
  font-size: 26rpx;
}

.type-line {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero-image {
  width: 220rpx;
  height: 220rpx;
}

.card-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 18rpx;
  padding: 20rpx;
}

.card-hero-art {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 128rpx;
  height: 180rpx;
  border-radius: 10rpx;
  background: #f8fafc;
}

.card-hero-art image {
  width: 120rpx;
  height: 170rpx;
  border-radius: 8rpx;
}

.card-hero-copy {
  flex: 1;
  min-width: 0;
}

.card-hero-name {
  overflow: hidden;
  margin-top: 8rpx;
  color: #101828;
  font-size: 36rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-hero-sub {
  margin-top: 6rpx;
  color: #697586;
  font-size: 24rpx;
}

.card-hero-meta {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 900;
}

.pack-home-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1f7ff 100%);
}

.pack-home-copy {
  flex: 1;
  min-width: 0;
}

.pack-home-title {
  overflow: hidden;
  margin-top: 6rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pack-home-sub {
  margin-top: 6rpx;
  color: #697586;
  font-size: 22rpx;
}

.pack-home-logo {
  flex: 0 0 auto;
  width: 166rpx;
  height: 88rpx;
}

.pack-home-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 32rpx;
  font-weight: 900;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.section .quick-grid {
  margin-top: 0;
}

.quick-card {
  min-height: 148rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
  box-sizing: border-box;
}

.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.quick-title {
  margin-top: 10rpx;
  color: #182230;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-sub {
  margin-top: 2rpx;
  color: #697586;
  font-size: 20rpx;
}

.deck-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.deck-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 14rpx 16rpx;
}

.deck-rank {
  flex: 0 0 62rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
}

.deck-icons {
  display: flex;
  align-items: center;
  flex: 0 0 104rpx;
}

.deck-icons image {
  width: 54rpx;
  height: 54rpx;
  margin-right: -10rpx;
}

.deck-copy {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
}

.deck-name {
  overflow: hidden;
  color: #182230;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deck-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 70rpx;
  min-height: 44rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
}

.recent-row {
  white-space: nowrap;
}

.recent-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin-right: 14rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #334155;
  font-size: 22rpx;
}

.recent-card image {
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 8rpx;
}

.recent-card-row {
  white-space: nowrap;
}

.recent-tcg-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 202rpx;
  margin-right: 14rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #334155;
  font-size: 22rpx;
}

.recent-tcg-card image {
  width: 94rpx;
  height: 132rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.featured-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.featured-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.featured-item image {
  width: 84rpx;
  height: 84rpx;
  margin-right: 16rpx;
}

.featured-copy {
  flex: 1;
}

.featured-name {
  color: #182230;
  font-size: 30rpx;
  font-weight: 700;
}

.featured-types {
  display: flex;
  gap: 8rpx;
}

.featured-card-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.featured-card-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.featured-card-item image {
  width: 78rpx;
  height: 110rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
}

.featured-rarity {
  flex: 0 0 auto;
  max-width: 150rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #465467;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}
