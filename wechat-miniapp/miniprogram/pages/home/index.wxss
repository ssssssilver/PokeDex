.home-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin: 8rpx 0 20rpx;
}

.eyebrow {
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 6rpx;
  color: #101828;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.source-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.home-search {
  margin-bottom: 24rpx;
}

.search-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.search-tab {
  min-height: 54rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #697586;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: center;
}

.search-tab.active {
  background: #0f766e;
  color: #ffffff;
}

.search-action {
  flex: 0 0 auto;
  margin-left: 16rpx;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 280rpx;
  padding: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8fff7 100%);
}

.hero-copy {
  flex: 1;
}

.hero-name {
  margin-top: 8rpx;
  color: #101828;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-en {
  margin-top: 6rpx;
  color: #697586;
  font-size: 26rpx;
}

.type-line {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.hero-image {
  width: 220rpx;
  height: 220rpx;
}

.card-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: 18rpx;
  padding: 20rpx;
}

.card-hero-art {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 128rpx;
  height: 180rpx;
  border-radius: 10rpx;
  background: #f8fafc;
}

.card-hero-art image {
  width: 120rpx;
  height: 170rpx;
  border-radius: 8rpx;
}

.card-hero-copy {
  flex: 1;
  min-width: 0;
}

.card-hero-name {
  overflow: hidden;
  margin-top: 8rpx;
  color: #101828;
  font-size: 36rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-hero-sub {
  margin-top: 6rpx;
  color: #697586;
  font-size: 24rpx;
}

.card-hero-meta {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 22rpx;
  font-weight: 900;
}

.pack-home-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f1f7ff 100%);
}

.pack-home-copy {
  flex: 1;
  min-width: 0;
}

.pack-home-title {
  overflow: hidden;
  margin-top: 6rpx;
  color: #101828;
  font-size: 32rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pack-home-sub {
  margin-top: 6rpx;
  color: #697586;
  font-size: 22rpx;
}

.pack-home-logo {
  flex: 0 0 auto;
  width: 166rpx;
  height: 88rpx;
}

.pack-home-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 32rpx;
  font-weight: 900;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.section .quick-grid {
  margin-top: 0;
}

.quick-card {
  min-height: 148rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
  box-sizing: border-box;
}

.quick-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #e6fffb;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.quick-title {
  margin-top: 10rpx;
  color: #182230;
  font-size: 24rpx;
  font-weight: 700;
}

.quick-sub {
  margin-top: 2rpx;
  color: #697586;
  font-size: 20rpx;
}

.deck-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.deck-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 14rpx 16rpx;
}

.deck-rank {
  flex: 0 0 62rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 900;
}

.deck-icons {
  display: flex;
  align-items: center;
  flex: 0 0 104rpx;
}

.deck-icons image {
  width: 54rpx;
  height: 54rpx;
  margin-right: -10rpx;
}

.deck-copy {
  flex: 1;
  min-width: 0;
  margin-left: 8rpx;
}

.deck-name {
  overflow: hidden;
  color: #182230;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-row {
  white-space: nowrap;
}

.recent-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  margin-right: 14rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #334155;
  font-size: 22rpx;
}

.recent-card image {
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 8rpx;
}

.recent-card-row {
  white-space: nowrap;
}

.recent-tcg-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 156rpx;
  height: 202rpx;
  margin-right: 14rpx;
  border: 1rpx solid #e6eaf0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #334155;
  font-size: 22rpx;
}

.recent-tcg-card image {
  width: 94rpx;
  height: 132rpx;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.featured-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.featured-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.featured-item image {
  width: 84rpx;
  height: 84rpx;
  margin-right: 16rpx;
}

.featured-copy {
  flex: 1;
}

.featured-name {
  color: #182230;
  font-size: 30rpx;
  font-weight: 700;
}

.featured-types {
  display: flex;
  gap: 8rpx;
}

.featured-card-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.featured-card-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
}

.featured-card-item image {
  width: 78rpx;
  height: 110rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
}

.featured-rarity {
  flex: 0 0 auto;
  max-width: 150rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #465467;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}
