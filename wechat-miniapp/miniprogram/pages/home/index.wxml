<view class="page home-page">
  <view class="home-banner">
    <image src="/assets/banner/home-banner.jpg" mode="aspectFill" />
    <view class="home-banner-title">宝批小站</view>
  </view>

  <view class="search-tabs three-tabs"><view class="search-tab {{homeMode === 'pokemon' ? 'active' : ''}}" data-target="pokemon" bindtap="switchHomeMode">宝可梦</view><view class="search-tab {{homeMode === 'card' ? 'active' : ''}}" data-target="card" bindtap="switchHomeMode">实体卡牌</view><view class="search-tab {{homeMode === 'pocket' ? 'active pocket' : ''}}" data-target="pocket" bindtap="switchHomeMode">Pocket</view></view>
  <view class="search-box home-search"><input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="submitSearch" confirm-type="search" placeholder="{{homeMode === 'pokemon' ? '搜索宝可梦名称或编号' : homeMode === 'card' ? '搜索实体卡牌、系列或编号' : '搜索 Pocket 卡牌'}}" /><view class="search-action" bindtap="submitSearch">搜索</view></view>

  <view class="section home-quick-section"><view class="section-title"><text>常用功能</text></view>
    <view wx:if="{{homeMode === 'pokemon'}}" class="quick-grid">
      <view class="quick-card" bindtap="openPokedex"><view class="quick-icon">鉴</view><view class="quick-title">宝可梦图鉴</view><view class="quick-sub">搜索与筛选</view></view>
      <view class="quick-card" bindtap="openQuiz"><view class="quick-icon">猜</view><view class="quick-title">宝可梦猜谜</view><view class="quick-sub">随机 4 选 1</view></view>
      <view class="quick-card" bindtap="openTeam"><view class="quick-icon">队</view><view class="quick-title">队伍分析</view><view class="quick-sub">多队伍编辑</view></view>
      <view class="quick-card" bindtap="openTypes"><view class="quick-icon gold">属</view><view class="quick-title">属性速查</view><view class="quick-sub">克制关系</view></view>
      <view class="quick-card" bindtap="openPlay"><view class="quick-icon ink">玩</view><view class="quick-title">玩法盒子</view><view class="quick-sub">宝可梦玩法</view></view>
    </view>
    <view wx:elif="{{homeMode === 'card'}}" class="quick-grid">
      <view class="quick-card" bindtap="openCarddex"><view class="quick-icon">鉴</view><view class="quick-title">卡牌图鉴</view><view class="quick-sub">实体卡牌</view></view>
      <view class="quick-card" bindtap="openCardQuiz"><view class="quick-icon">猜</view><view class="quick-title">猜卡牌</view><view class="quick-sub">今日挑战</view></view>
      <view class="quick-card" bindtap="openCardPack"><view class="quick-icon blue">包</view><view class="quick-title">每日开包</view><view class="quick-sub">手动开启</view></view>
      <view class="quick-card" bindtap="openHotDecks"><view class="quick-icon coral">组</view><view class="quick-title">热门卡组</view><view class="quick-sub">排行榜</view></view>
      <view class="quick-card" bindtap="openPlay"><view class="quick-icon ink">玩</view><view class="quick-title">玩法盒子</view><view class="quick-sub">实体卡玩法</view></view>
    </view>
    <view wx:else class="quick-grid">
      <view class="quick-card" bindtap="openPocketCarddex"><view class="quick-icon">鉴</view><view class="quick-title">Pocket图鉴</view><view class="quick-sub">搜索与筛选</view></view>
      <view class="quick-card" data-tab="events" bindtap="openPocketEvents"><view class="quick-icon coral">活</view><view class="quick-title">活动</view><view class="quick-sub">当前与预告</view></view>
      <view class="quick-card" bindtap="openCardPack"><view class="quick-icon blue">包</view><view class="quick-title">模拟开包</view><view class="quick-sub">5 张一包</view></view>
      <view class="quick-card" bindtap="openPocketDecks"><view class="quick-icon ink">组</view><view class="quick-title">热门卡组</view><view class="quick-sub">赛事数据</view></view>
      <view class="quick-card" bindtap="openPlay"><view class="quick-icon gold">玩</view><view class="quick-title">玩法盒子</view><view class="quick-sub">Pocket玩法</view></view>
    </view>
  </view>

  <block wx:if="{{homeMode === 'pokemon'}}">
    <view wx:if="{{dailyPokemon}}" class="card hero-card" data-id="{{dailyPokemon.id}}" bindtap="openPokemon"><view class="hero-copy"><view class="muted">今日宝可梦</view><view class="hero-name">{{dailyPokemon.name_zh}}</view><view class="hero-en">#{{dailyPokemon.id}} {{dailyPokemon.name_en}}</view><view class="type-line"><view wx:for="{{dailyPokemon.types}}" wx:key="*this" class="type-badge type-{{item}}">{{dailyPokemon.typeNames[index]}}</view></view></view><image class="hero-image" src="{{dailyPokemon.image}}" mode="aspectFit" /></view>
    <view class="section"><view class="section-title"><text>最近查看</text><text class="muted" bindtap="openPokedex">去宝可梦图鉴</text></view><scroll-view wx:if="{{recent.length}}" scroll-x class="recent-row"><view wx:for="{{recent}}" wx:key="id" class="recent-card" data-id="{{item.id}}" bindtap="openPokemon"><image src="{{item.image}}" mode="aspectFit" /><view>{{item.name_zh}}</view></view></scroll-view><view wx:else class="card empty-state"><view class="title">还没有浏览记录</view></view></view>
  </block>

  <block wx:elif="{{homeMode === 'card'}}">
    <view wx:if="{{dailyCard}}" class="card card-hero" data-id="{{dailyCard.id}}" bindtap="openCard"><view class="card-hero-art"><image src="{{dailyCard.image}}" mode="aspectFit" /></view><view class="card-hero-copy"><view class="muted">今日实体卡牌</view><view class="card-hero-name">{{dailyCard.display_name || dailyCard.name_zh || dailyCard.name}}</view><view class="card-hero-sub">#{{dailyCard.number}}</view><view class="card-hero-meta">{{dailyCard.rarity_name || dailyCard.rarity}}</view></view></view>
    <view wx:if="{{hotDecks.length}}" id="physical-hot-decks" class="section">
      <view class="section-title"><text>热门卡组</text><text class="muted" bindtap="openHotDecks">排行榜</text></view>
      <view class="deck-list">
        <view wx:for="{{hotDecks}}" wx:key="rank" class="deck-row card" data-url="{{item.url}}" data-name="{{item.name}}" data-rank="{{item.rank}}" data-points="{{item.points}}" data-share="{{item.share}}" bindtap="openDeck">
          <view class="deck-rank">#{{item.rank}}</view>
          <view class="deck-icons"><image wx:for="{{item.images}}" wx:for-item="icon" wx:key="src" src="{{icon.src}}" mode="aspectFit" /></view>
          <view class="deck-copy"><view class="deck-name">{{item.name}}</view><view class="muted">{{item.points}} 分 · {{item.share}}</view></view>
        </view>
      </view>
    </view>
    <view class="section"><view class="section-title"><text>最近看卡</text><text class="muted" bindtap="openCarddex">去实体卡牌图鉴</text></view><scroll-view wx:if="{{recentCards.length}}" scroll-x class="recent-card-row"><view wx:for="{{recentCards}}" wx:key="id" class="recent-tcg-card" data-id="{{item.id}}" bindtap="openCard"><image src="{{item.image}}" mode="aspectFit" /><view>{{item.display_name}}</view></view></scroll-view><view wx:else class="card empty-state"><view class="title">还没有看过实体卡牌</view></view></view>
  </block>

  <block wx:else>
    <view wx:if="{{dailyPocketCard}}" class="pocket-home-card" data-id="{{dailyPocketCard.id}}" bindtap="openPocketCard"><view class="pocket-home-art"><image src="{{dailyPocketCard.image}}" mode="aspectFit" /></view><view class="pocket-home-copy"><view class="pocket-label">今日 Pocket 卡牌</view><view class="pocket-name">{{dailyPocketCard.name_zh}}</view><view class="pocket-en">{{dailyPocketCard.name_en}}</view><view class="pocket-meta">{{dailyPocketCard.collections[0].expansion_id}} #{{dailyPocketCard.collections[0].number}} · {{dailyPocketCard.rarity}}</view></view><view class="pocket-arrow">›</view></view>
    <view class="section pocket-panel-section"><view class="section-title"><text>活动动态</text><text class="muted" data-tab="events" bindtap="openPocketEvents">全部活动</text></view><view class="pocket-event-list"><view wx:for="{{pocketEvents}}" wx:key="id" class="pocket-event-row" data-tab="events" bindtap="openPocketEvents"><text>{{item.typeText}}</text><view><strong>{{item.name_zh}}</strong><view>{{item.statusText}}</view></view></view></view></view>
    <view class="section pocket-panel-section"><view class="section-title"><text>热门 Pocket 卡组</text><text class="muted" bindtap="openPocketDecks">排行榜</text></view><view class="pocket-deck-list"><view wx:for="{{pocketDecks}}" wx:key="id" class="pocket-deck-row" data-id="{{item.id}}" bindtap="openPocketDeck"><text>#{{item.rank}}</text><view class="home-pocket-deck-icons"><image wx:for="{{item.images}}" wx:for-item="icon" wx:key="*this" src="{{icon}}" mode="aspectFit" /></view><view><strong>{{item.name}}</strong><view>使用率 {{item.share}}% · 胜率 {{item.win_rate}}%</view></view></view></view></view>
    <view class="section"><view class="section-title"><text>最近看卡</text><text class="muted" bindtap="openPocketCarddex">去 Pocket 图鉴</text></view><scroll-view wx:if="{{recentPocketCards.length}}" scroll-x class="recent-card-row"><view wx:for="{{recentPocketCards}}" wx:key="id" class="recent-tcg-card" data-id="{{item.id}}" bindtap="openPocketCard"><image src="{{item.image}}" mode="aspectFit" /><view>{{item.name_zh}}</view></view></scroll-view><view wx:else class="card empty-state"><view class="title">还没有看过 Pocket 卡牌</view></view></view>
  </block>
</view>
